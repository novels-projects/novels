# Application Port
APP_PORT=8080

# PostgreSQL Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=novel_user
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DBNAME=novel_db
POSTGRES_SSLMODE=disable

# MinIO Configuration (Object Storage สำหรับรูปภาพและสื่อ)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minionovel
MINIO_SECRET_KEY=minionovel123
MINIO_USE_SSL=false

# CORS - โดเมน Frontend ที่อนุญาตให้เรียก API (คั่นด้วย comma ห้ามมีเว้นวรรค)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# JWT Configuration (Secret Keys สำหรับ Access Token และ Refresh Token)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
